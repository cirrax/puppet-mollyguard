#!/bin/sh
#
# Managed with puppet (module mollyguard)
#
# This script checks if the local node is a postgres master
# managed with repmgr
#

set -e

if ! su - postgres -c "repmgr node check --role" | grep -q "OK (node is standby)"; then
    printf "\nThis PostgreSQL node is not a standby, or repmgr returned an error.\n\n"

    su - postgres -c "repmgr node check" || true
    printf "\n"

    printf "Continue with '%s'? (y/N) " "$MOLLYGUARD_CMD"
    read answer

    [ "$answer" = "y" ] || exit 1
fi

printf "\nPostgres/repmgr reports this node as standby. Continuing.\n\n"

exit 0
